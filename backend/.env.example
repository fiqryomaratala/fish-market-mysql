APP_NAME=Fish Marketplace Backend
APP_ENV=development
APP_PORT=8080

# Untuk local Go run, BASE_URL bisa tetap http://localhost.
# Untuk webhook Xendit dari tunnel/public URL, ganti ke domain publik backend kamu.
BASE_URL=http://localhost

# URL frontend yang akan dipakai untuk success/failure redirect sesudah checkout Xendit.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=3306
DB_USER=fishuser
DB_PASSWORD=fishpass
DB_NAME=fish_market_db
DB_CHARSET=utf8mb4

JWT_SECRET=your-secret-key
JWT_EXPIRED=24h

UPLOAD_PATH=/app/uploads

# Xendit Payment Link
# Gunakan API key dari Xendit dashboard:
# - test mode biasanya diawali xnd_development_
# - production mode biasanya diawali xnd_production_
XENDIT_API_KEY=xnd_development_your_api_key

# Callback token untuk verifikasi webhook Xendit.
# Nilai ini harus sama dengan token callback yang dikonfigurasi di dashboard Xendit.
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token
